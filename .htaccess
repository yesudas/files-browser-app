# ── Prevent directory listing ──
#Options -Indexes

# ── Set index file ──
#DirectoryIndex index.php

# ── Enable rewrite engine ──
RewriteEngine On

# ── Force HTTPS (uncomment if your host supports it) ──
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Protect sensitive files from direct access ──
<FilesMatch "^(counter\.txt|bot\.log|\.DS_Store|.*\.ffs_db|.*\.ffs_lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Block direct access to the data/ directory ───────────────────
# (files must be served through download.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/(.*)$ - [F,L]
</IfModule>

# ── Block direct access to the reports/ directory ─────────────────
# (copyright report JSON files are only ever read server-side by a.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^reports/(.*)$ - [F,L]
</IfModule>

# ── PHP settings for uploads ──────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize  512M
    php_value post_max_size        520M
    php_value max_execution_time   300
    php_value max_input_time       300
    php_value memory_limit         256M
    # Prevent uploaded files from being interpreted as PHP
    php_flag  engine Off
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize  512M
    php_value post_max_size        520M
    php_value max_execution_time   300
    php_value max_input_time       300
    php_value memory_limit         256M
    php_flag  engine Off
</IfModule>

# ── Detect embed mode from the query string ───────────────────────
# Sets the EMBED_MODE env var when ?embed=1 is present.
# Used below to suppress X-Frame-Options so cross-origin iframes work.
#SetEnvIf Query_String "embed=1" EMBED_MODE

# ── Security headers ──────────────────────────────────────────────
#<IfModule mod_headers.c>
#    Header always set X-Content-Type-Options "nosniff"
#    Header always set Referrer-Policy "same-origin"

    # X-Frame-Options — handled conditionally:
    # 1. Always unset first (strips any header the server/host injects)
    # 2. Re-apply SAMEORIGIN only when NOT in embed mode
    # Embed mode (?embed=1) intentionally omits the header so that
    # cross-origin sites (e.g. WordOfGod.in) can frame the page.
#    Header always unset X-Frame-Options
#    Header always set   X-Frame-Options "SAMEORIGIN" env=!EMBED_MODE
#</IfModule>x

Header always set Content-Security-Policy: upgrade-insecure-requests

## 🤖 Fine-Tuned Bot Blocking ##

# 1. Block known bad bots only (empty UA check removed — causes false positives)
# RewriteCond %{HTTP_USER_AGENT} (curl|python-requests|wget|libwww-perl|MJ12bot|AhrefsBot|SemrushBot|GPTBot|ClaudeBot) [NC]
# RewriteRule .* - [F,L]

# WordOfGod.in - AI Scraper Rate Limiting
# Updated: 2026-01-31
# Strategy: Allow all crawlers but limit them to 10 requests per minute

# Rate limiting using mod_rewrite and environment variables
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Identify AI/LLM crawlers and set environment variable for stricter limiting
    RewriteCond %{HTTP_USER_AGENT} (crawl|GPTBot|ChatGPT|Claude|ClaudeBot|anthropic|CCBot|Google-Extended|Omgilibot|Amazonbot|Bytespider|PerplexityBot|Applebot-Extended|Diffbot|ImagesiftBot|img2dataset|cohere-ai|FacebookBot) [NC]
    RewriteRule .* - [E=AI_CRAWLER:1]
</IfModule>

# Rate limiting for AI crawlers (requires mod_ratelimit)
# Limit to ~10 requests per minute = 166 bytes per second for average 1KB pages
<IfModule mod_ratelimit.c>
    <If "%{ENV:AI_CRAWLER} == '1'">
        # Very slow rate for AI crawlers: 200 bytes/sec ≈ 12 requests/min for 1KB pages
        SetOutputFilter RATE_LIMIT
        SetEnv rate-limit 200
    </If>

    <Else>
        # Normal rate for legitimate users: no limiting
        # (or set a higher limit like 10000 bytes/sec if needed)
    </Else>
</IfModule>

# Alternative: Use mod_qos for more precise per-IP rate limiting
# Uncomment if mod_qos is available (better than mod_ratelimit)
# <IfModule mod_qos.c>
#     # Maximum 10 requests per minute per IP
#     QS_SrvMaxConnPerIP 10
#
#     # Maximum concurrent connections
#     QS_SrvMaxConn 100
#
#     # Request rate: 10 requests per 60 seconds per IP
#     QS_LocRequestPerSecLimit 10 60
# </IfModule>

# Additional headers to inform crawlers about rate limits
<IfModule mod_headers.c>
    # Suggest crawl delay to well-behaved bots
    Header set X-Crawl-Delay "6"

    # Prevent AI training on your content (some crawlers respect this)
    Header set X-Robots-Tag "noai, noimageai"

    # For AI crawlers, set more aggressive delay hint
    <If "%{ENV:AI_CRAWLER} == '1'">
        Header set X-Crawl-Delay "30"
        Header set Retry-After "30"
    </If>
</IfModule>

# Connection limiting (alternative approach using mod_limitipconn)
# Uncomment if available - limits concurrent connections per IP
# <IfModule mod_limitipconn.c>
#     # Maximum 3 concurrent connections per IP
#     MaxConnPerIP 3
#
#     # Only apply to certain file types
#     <Location />
#         MaxConnPerIP 3
#     </Location>
# </IfModule>

# Cache control for sitemap files (index + per-folder chunks)
<IfModule mod_headers.c>
    <FilesMatch "^sitemap.*\.xml$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>

# Optional: Log AI crawler requests separately for monitoring
<IfModule mod_rewrite.c>
    RewriteCond %{ENV:AI_CRAWLER} =1
    RewriteRule .* - [E=log_ai_crawler:1]
</IfModule>

# Custom log format for AI crawlers (add to your Apache config if needed)
# LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" ai_crawler_log
# CustomLog /var/log/apache2/ai_crawlers.log ai_crawler_log env=log_ai_crawler

ErrorDocument 403     /cgi-sys/403_def.html
ErrorDocument 404     /cgi-sys/404_def.html
ErrorDocument 500     /cgi-sys/500_def.html
ErrorDocument 502     /cgi-sys/502_def.html
ErrorDocument 503     /cgi-sys/503_def.html
ErrorDocument 504     /cgi-sys/504_def.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ── PHP settings (if allowed by host) ──
<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>

# ── Cache static assets ──
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png            "access plus 30 days"
    ExpiresByType image/jpeg           "access plus 30 days"
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>
